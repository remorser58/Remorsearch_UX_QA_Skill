{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/remorser58/ux-research-qa-skills/schemas/ux-evidence-bundle.v1.schema.json",
  "title": "UX Evidence Bundle v1",
  "type": "object",
  "required": ["schema_version", "bundle_id", "permissions", "records"],
  "properties": {
    "schema_version": {"const": "ux-evidence-bundle.v1"},
    "bundle_id": {"type": "string", "minLength": 1},
    "permissions": {
      "type": "object",
      "required": ["requested", "granted", "blocked"],
      "properties": {
        "requested": {"type": "array", "items": {"$ref": "#/$defs/capability"}, "uniqueItems": true},
        "granted": {"type": "array", "items": {"$ref": "#/$defs/capability"}, "uniqueItems": true},
        "blocked": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["capability", "reason"],
            "properties": {
              "capability": {"$ref": "#/$defs/capability"},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "records": {
      "type": "object",
      "required": ["sources", "evidence", "claims", "personas", "scenarios", "runs", "observations", "findings", "proposals", "figma"],
      "properties": {
        "sources": {"$ref": "#/$defs/records"},
        "evidence": {"$ref": "#/$defs/records"},
        "claims": {"$ref": "#/$defs/records"},
        "personas": {"$ref": "#/$defs/records"},
        "scenarios": {"$ref": "#/$defs/records"},
        "runs": {"$ref": "#/$defs/records"},
        "observations": {"$ref": "#/$defs/records"},
        "findings": {"$ref": "#/$defs/records"},
        "proposals": {"$ref": "#/$defs/records"},
        "figma": {"$ref": "#/$defs/records"}
      }
    }
  },
  "$defs": {
    "capability": {"enum": ["read_only", "design_write", "test_data_write", "code_write"]},
    "records": {
      "type": "array",
      "items": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string", "minLength": 1}}}
    }
  }
}
