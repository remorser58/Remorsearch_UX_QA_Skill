          "padding": "0px",
          "whiteSpace": "normal",
          "overflow": "visible"
        },
        {
          "text": "제약 검사 · 충돌 후보 표시 · 공백 확인 · 사람 확정",
          "selector": "DD",
          "x": 24,
          "y": 713.453125,
          "w": 342,
          "h": 62.46875,
          "font": "\"Pretendard Variable\", Pretendard, -apple-system, \"SF Pro Text\", \"Helvetica Neue\", sans-serif",
